[
  {
    "分類": "母音",
    "說明": [
      "音節 : 母音跟周圍子音組成的發音單元",
      "閉音節 : 一個音節以子音結尾，母音通常發短音，如 : 母+子 / 母+子+子+母",
      "開音節 : 一個音節以母音結尾，母音通常發長音(字母本身的音)，如 : 子+母 / 母+子+母",
      "兩個母音相連 : 第一個母音發長音(字母本身的音)，第二個母音不發音，如 : 母+母+子"
    ],
    "規則": [
      {
        "母音": "a",
        "音標": "[ æ ]",
        "說明": "閉音節",
        "範例": [
          "apple",
          "hat",
          "bag",
          "cat"
        ]
      },
      {
        "母音": "a",
        "音標": "[ e ]",
        "說明": "開音節、母音相連",
        "範例": [
          "wait",
          "rain",
          "train",
          "tail",
          "say",
          "day",
          "play",
          "stay",
          "take",
          "cake",
          "game"
        ]
      },
